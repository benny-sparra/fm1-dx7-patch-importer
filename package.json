{
  "name": "fm1-editor-librarian",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite --mode https --host 127.0.0.1",
    "dev:http": "vite",
    "dev:https": "vite --mode https --host 127.0.0.1",
    "setup:https": "bash scripts/setup-https.sh",
    "build": "vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "catalog:index": "vitest run src/data/dx7-catalog-index.test.ts --update",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm test && npm run images:check && npm run icons:check && npm run build && npm run images:check:dist && npm run security:check && npm run sourcemaps:check && npm run bundle:check",
    "check:install": "npx --yes npm@11.16.0 ci --dry-run --ignore-scripts --no-audit --no-fund",
    "deps:audit": "npm audit --audit-level=high",
    "deps:audit:prod": "npm audit --omit=dev --audit-level=high",
    "deps:check": "knip --no-config-hints",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:check": "node scripts/generate-responsive-images.mjs --check",
    "images:check:dist": "node scripts/check-responsive-images-dist.mjs",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "icons:check": "node scripts/generate-app-icons.mjs --check",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "lint": "npm run lint:code && npm run lint:css",
    "lint:code": "oxlint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:fix": "oxlint --fix && npm run lint:css:fix",
    "lockfile:refresh": "npx --yes npm@11.16.0 install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "security:check": "node scripts/check-security-headers.mjs",
    "sourcemaps:check": "node scripts/check-source-maps.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run src/test/accessibility.a11y.test.tsx",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -b",
    "test:cls": "npm run build && node scripts/check-layout-shift.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^10.75.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwind-merge": "^3.7.0",
    "webmidi": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "knip": "6.38.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "stylelint": "17.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true
  }
}
