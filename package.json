{
  "name": "fm1-editor-librarian",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite --mode https --host 127.0.0.1",
    "dev:http": "vite",
    "dev:https": "vite --mode https --host 127.0.0.1",
    "setup:https": "bash scripts/setup-https.sh",
    "build": "vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm test && npm run build && npm run bundle:check",
    "check:install": "npx --yes npm@11.16.0 ci --dry-run --ignore-scripts --no-audit --no-fund",
    "deps:audit": "npm audit --audit-level=high",
    "deps:audit:prod": "npm audit --omit=dev --audit-level=high",
    "deps:check": "knip --no-config-hints",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:code && npm run lint:css",
    "lint:code": "oxlint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:fix": "oxlint --fix && npm run lint:css:fix",
    "lockfile:refresh": "npx --yes npm@11.16.0 install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "test": "vitest run",
    "test:a11y": "vitest run src/test/accessibility.a11y.test.tsx",
    "typecheck": "tsc -b",
    "test:cls": "npm run build && node scripts/check-layout-shift.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "webmidi": "^3.1.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "knip": "6.32.2",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.14.1",
    "tailwindcss": "4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
